NODE_ENV=development
PORT=3000
# En az 32 baytlik rastgele bir deger kullanin.
JWT_SECRET=change-me-with-a-long-random-secret
APP_ENCRYPTION_KEY=change-me-with-another-long-random-secret
# Virgulle ayrilmis izinli web adresleri. Bos ise ayni origin kabul edilir.
ALLOWED_ORIGINS=http://localhost:3000
# Yalnizca gelistirme ortaminda mock provider acmak icin true yapin.
ENABLE_MOCK_PROVIDER=false
ALLOW_PRIVATE_PROVIDER_URLS=false
# Gercek odeme saglayicisi aktif edilene kadar false kalmalidir.
ENABLE_DEMO_PAYMENTS=false
PUBLIC_BASE_URL=https://example.com
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
PAYTR_TEST_MODE=1
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=SMM Panel <noreply@example.com>
# Telegram bildirim botu (yeni kayit / yeni siparis). Normalde admin panelinden
# girilir; buradaki degerler yalnizca panelde bir sey kayitli degilse kullanilir.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
